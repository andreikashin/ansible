services:
  traefik:
    image: traefik:v3.0
    container_name: traefik
    restart: always
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
      # - "8080:8080" # You can open this for testing, but it's better to keep it closed and access via the domain
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - ./acme.json:/acme.json
    networks:
      - traefik_net
    labels:
      - "traefik.enable=true"
      # Router for Dashboard (HTTPS)
      - "traefik.http.routers.dashboard.rule=Host(`{{ traefik_dashboard_domain }}`)"
      - "traefik.http.routers.dashboard.service=api@internal"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.dashboard.middlewares=auth"
      # Middleware for password
      - "traefik.http.middlewares.auth.basicauth.users={{ traefik_dashboard_auth }}"

networks:
  traefik_net:
    name: traefik_net
    external: true