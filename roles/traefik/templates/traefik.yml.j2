api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false  # Important! Do not expose containers without explicit permission
    network: traefik_net   # Docker network used by Traefik to discover services

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_acme_email }}
      storage: acme.json
      # Use HTTP Challenge (open 80 port)
      httpChallenge:
        entryPoint: web